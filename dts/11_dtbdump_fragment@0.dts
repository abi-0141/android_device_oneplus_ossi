	fragment@72 {
		target = <0xffffffff>;

		__overlay__ {

			eint0default {
				phandle = <0x23>;
			};

			charger_gpio_as_output_low {
				phandle = <0x24>;

				pins_cmd_dat {
					pinmux = <0x1900>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			charger_gpio_as_output_high {
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0x1900>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			ship_sleep {
				phandle = <0x26>;

				pins_cmd_dat {
					pinmux = <0x6c00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			ship_active {
				phandle = <0x27>;

				pins_cmd_dat {
					pinmux = <0x6c00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			dischg_enable {
				phandle = <0x28>;

				pins_cmd_dat {
					pinmux = <0x8d00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			dischg_disable {
				phandle = <0x29>;

				pins_cmd_dat {
					pinmux = <0x8d00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			chgvin_enable {
				phandle = <0x2a>;

				pins_cmd_dat {
					pinmux = <0x6f00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			chgvin_disable {
				phandle = <0x2b>;

				pins_cmd_dat {
					pinmux = <0x6f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			pmic_chgfunc_enable {
				phandle = <0x2c>;

				pins_cmd_dat {
					pinmux = <0x8e00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			pmic_chgfunc_disable {
				phandle = <0x2d>;

				pins_cmd_dat {
					pinmux = <0x8e00>;
					slew-rate = <0x01>;
					output-high;
				};
			};
		};
	};

