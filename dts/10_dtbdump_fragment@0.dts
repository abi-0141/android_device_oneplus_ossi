	fragment@66 {
		target = <0xffffffff>;

		__overlay__ {

			eint0default {
				phandle = <0x27>;
			};

			charger_gpio_as_output_low {
				phandle = <0x28>;

				pins_cmd_dat {
					pinmux = <0x1900>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			charger_gpio_as_output_high {
				phandle = <0x29>;

				pins_cmd_dat {
					pinmux = <0x1900>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			dischg_enable {
				phandle = <0x2a>;

				pins_cmd_dat {
					pinmux = <0xa700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			dischg_disable {
				phandle = <0x2b>;

				pins_cmd_dat {
					pinmux = <0xa700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			ccdetect_active {
				phandle = <0x2c>;

				pins_cmd_dat {
					pinmux = <0x600>;
					input-enable;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			ccdetect_sleep {
				phandle = <0x2d>;

				pins_cmd_dat {
					pinmux = <0x600>;
					input-enable;
					slew-rate = <0x00>;
					bias-disable;
				};
			};
		};
	};

