				pressure_report_support;
				charger_pump_support;
				game_switch_support;
				smart_gesture_support;
				fw_update_app_support;
				fingerprint_underscreen_support;
				headset_pump_support;
				health_monitor_v2_support;
				high_resolution_support;
				lcd_tp_refresh_support;
				touchpanel,button-type = <0x04>;
				touchpanel.button-TRx = <0x00 0x00>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			eintdefault {
				phandle = <0x5f>;
			};

			int_active {
				phandle = <0x60>;

				pins_cmd_dat {
					pinmux = <0xe00>;
					slew-rate = <0x00>;
					bias-pull-down = <0x00>;
