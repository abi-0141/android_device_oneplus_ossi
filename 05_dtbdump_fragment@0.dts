				touchpanel,smooth-level = <0xff 0x02 0x0f 0x19 0x2d 0x3c>;
				touchpanel,smooth-level-charging = <0xff 0x0f 0x14 0x19 0x2d 0x3c>;
				touchpanel,sensitive-level = <0xff 0x14 0x10 0x0d 0x0a 0x05>;
				touchpanel,single-optimized-time = <0x08>;
