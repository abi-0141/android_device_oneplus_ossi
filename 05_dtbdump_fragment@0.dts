					slew-rate = <0x01>;
					output-high;
				};
			};

			dischg_enable {
				phandle = <0x29>;

				pins_cmd_dat {
					pinmux = <0xa700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			dischg_disable {
				phandle = <0x2a>;

				pins_cmd_dat {
					pinmux = <0xa700>;
					slew-rate = <0x01>;
					output-low;
